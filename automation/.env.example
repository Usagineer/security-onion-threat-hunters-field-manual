# Copy to .env and fill in.  .env is gitignored — never commit real credentials.

# Elasticsearch endpoint on the Security Onion manager.
# Run so_hunt.py ON the manager, or from a host allowed to reach ES (see README).
SO_ES_URL=https://localhost:9200

# Index pattern. SO 2.4 uses data streams (logs-*); older/legacy uses so-*.
# Distributed deployments may need a cross-cluster prefix, e.g. *:so-*
SO_ES_INDEX=logs-*,so-*

# Option A — basic auth (an Elasticsearch user; see README for creating one)
SO_ES_USER=
SO_ES_PASS=

# Option B — API key (base64 "id:api_key"); if set, used instead of user/pass
SO_ES_API_KEY=
